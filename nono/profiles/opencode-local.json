{
  "extends": "opencode-pack",
  "meta": {
    "name": "opencode-local",
    "version": "1.0.0",
    "description": "Local overlay on the always-further/opencode pack profile",
    "author": "simon"
  },
  "filesystem": {
    "allow": [
      "$HOME/.agents",
      "$XDG_CONFIG_HOME/agents",
      "$XDG_CONFIG_HOME/opencode"
    ],
    "read": [
      "$XDG_CONFIG_HOME/gh",
      "$HOME/.local/share/gh"
    ]
  },
  "workdir": { "access": "readwrite" },
  "allow_gpu": true
}
